    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3",
    "node-cron": "^4.6.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
