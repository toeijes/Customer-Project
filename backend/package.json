{
  "name": "pwa6-expansion-backend",
  "version": "1.0.0",
  "description": "Backend API for PWA Area 6 Expansion Project Information System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "vitest run",
