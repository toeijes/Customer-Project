# Application
PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
# Active Directory (LDAPS only; validate server hostname and certificate)
LDAP_URL=ldaps://R06-DC01.pwa.local:636
LDAP_DOMAIN=PWA
LDAP_BASE_DN=dc=PWA,dc=local
LDAP_TIMEOUT_MS=5000
# Relative to backend/. Obtain the trusted CA from your AD administrators.
LDAP_CA_FILE=certs/pwa-ad-ca.pem
# Regional OU mappings for PWA areas 1-10. An explicit map overrides defaults.
LDAP_AREA_OU_MAP={"Reg01":"1","Reg02":"2","Reg03":"3","Reg04":"4","Reg05":"5","Reg06":"6","Reg07":"7","Reg08":"8","Reg09":"9","Reg10":"10"}
# Keep true for HTTPS. Set false only for temporary HTTP access on a trusted network.
COOKIE_SECURE=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-a-strong-password
DB_DATABASE=pwa6_expansion

# Runtime safety
SAFE_LOCAL_MODE=true
ENABLE_SCHEMA_INIT=false
# Use exactly one scheduler: host cron (ENABLE_DAILY_SYNC) or backend node-cron (ENABLE_CRON).
ENABLE_DAILY_SYNC=false
ENABLE_CRON=false

# Browser/API security
# Leave empty when the frontend is reverse-proxied at the same origin.
# For a separately hosted frontend, list every permitted origin, comma-separated.
CORS_ORIGINS=https://example.pwa.go.th
# Set to 1 only when the API is reached through one trusted reverse-proxy hop.
TRUST_PROXY=1
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
